<% layout("/layouts/boilerplate") %>
  <%= success %>
    <style>
      #filters {
        display: flex;
        justify-content: center;
        margin-top: 1rem;
      }

      .filter-container {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        /* keep everything in one row */
        overflow-x: auto;
        /* scroll if screen is small */
        gap: 1.5rem;
        width: 100%;
      }

      /* FIX filters */
      .filter {
        flex: 0 0 auto;
        /* prevents vertical stacking */
        text-align: center;
        opacity: 0.7;
        min-width: 80px;
      }

      .filter:hover {
        opacity: 1;
        cursor: pointer;
      }

      .filter p {
        font-size: 0.8rem;
      }

      /* tax info hidden */
      .tax-info {
        display: none;
      }

      /* FIX toggle */
      .tax-toggle {
        flex: 0 0 auto;
        /* stay in same row */
        margin-left: 1rem;
        /* space from filters */
        border: 1px solid black;
        border-radius: 1rem;
        padding: 0.6rem 1rem;

      }
    </style>
    <div id="filters">
      <div class="filter-container">

        <div class="filter" data-category="trending">
          <div>
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
          </div>
        </div>

        <div class="filter" data-category="rooms">
          <div>
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
          </div>
        </div>

        <div class="filter" data-category="mountains">
          <div>
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
          </div>
        </div>

        <div class="filter" data-category="castles">
          <div>
            <i class="fa-brands fa-fort-awesome"></i>
            <p>Castles</p>
          </div>
        </div>
        <div class="filter" id="nearbyFilter" data-category="narby">
          <div>
            <i class="fa-solid fa-location-dot"></i>
            <p>Nearby</p>
          </div>
        </div>
        <div class="filter" data-category="amazing pools">
          <div><i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
          </div>
        </div>
        <div class="filter " data-category="arctic">
          <div><i class="fa-solid fa-snowflake"></i>
            <p>Artic</p>
          </div>
        </div>
        <div class="filter" data-category="domes">
          <div><i class="fa-solid fa-igloo"></i>
            <p>Domes</p>
          </div>
        </div>
        <div class="filter" data-category="boats">
          <div><i class="fa-solid fa-sailboat"></i>
            <p>Boats</p>
          </div>
        </div>
        <div class="tax-toggle">
          <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
          </div>
        </div>
      </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 listing-card mt-3">

      <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem;">
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b><br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                  <i id="tax-info">&nbsp;&nbsp;+18%</i>
              </p>
            </div>
          </div>
        </a>

        <% } %>
    </div>

    <script>
      let taxSwitch = document.getElementById("switchCheckDefault");
      taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (info of taxInfo) {
          if (info.style.display != "inline") {
            info.style.display = "inline";
          }
          else {
            info.style.display = "none";

          }
        }
      })
    </script>
    <script src="/js/nearby.js"></script>

    <script src="/js/filters.js"></script>


